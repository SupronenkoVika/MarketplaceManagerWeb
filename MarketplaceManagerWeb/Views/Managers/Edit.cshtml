@model MarketplaceManagerWeb.Models.Manager

@{
    ViewData["Title"] = "Редактировать менеджера";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">✏️ Редактировать менеджера</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="ManagerID" />

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="ManagerLName" class="form-label">Фамилия</label>
                                <input asp-for="ManagerLName" class="form-control" required />
                                <span asp-validation-for="ManagerLName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="ManagerFName" class="form-label">Имя</label>
                                <input asp-for="ManagerFName" class="form-control" required />
                                <span asp-validation-for="ManagerFName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="ManagerMName" class="form-label">Отчество</label>
                                <input asp-for="ManagerMName" class="form-control" />
                                <span asp-validation-for="ManagerMName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ManagerLog" class="form-label">Логин для входа</label>
                            <input asp-for="ManagerLog" class="form-control" required />
                            <span asp-validation-for="ManagerLog" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ManagerPass" class="form-label">Новый пароль (необязательно)</label>
                            <input asp-for="ManagerPass" class="form-control" type="text" minlength="4" />
                            <span asp-validation-for="ManagerPass" class="text-danger"></span>
                            <small class="form-text text-muted">Оставьте пустым, чтобы сохранить текущий пароль</small>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="ManagerIsAdmin" class="form-check-input" type="checkbox" />
                            <label asp-for="ManagerIsAdmin" class="form-check-label">Администратор</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">Сохранить изменения</button>
                            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>