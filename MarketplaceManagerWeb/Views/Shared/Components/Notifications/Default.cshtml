@model IEnumerable<MarketplaceManagerWeb.Models.Product>

@{
    var count = Model.Count();
}

<li class="nav-item dropdown">
    <a class="nav-link position-relative" href="#" id="notificationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Уведомления">
        <!-- Иконка колокольчика (SVG) -->
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-bell" viewBox="0 0 16 16">
            <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5.002 5.002 0 0 1 13 6c0 .88.32 4.2 1.22 6z"/>
        </svg>

        @if (count > 0)
        {
                <!-- Красный бейдж с количеством -->
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @count
                    <span class="visually-hidden">уведомлений</span>
                </span>
        }
    </a>

    <!-- Выпадающее меню -->
    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationsDropdown" style="width: 320px; max-height: 400px; overflow-y: auto;">
        <li><h6 class="dropdown-header bg-light">⚠️ Заканчивается товар на складе</h6></li>

        @if (count > 0)
        {
            @foreach (var product in Model)
            {
                        <li>
                            <a class="dropdown-item py-2" href="/Products/Edit/@product.ProductID">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-truncate" style="max-width: 180px;">@product.ProductName</strong>
                                    <span class="badge bg-@(product.Stock == 0 ? "danger" : "warning") text-dark ms-2">
                                @product.Stock шт.
                                    </span>
                                </div>
                                <small class="text-muted">Артикул: @product.ProductArticle</small>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
            }
        }
        else
        {
                <li>
                    <div class="dropdown-item text-muted text-center py-3">
                        ✅ Все товары в наличии
                    </div>
                </li>
        }

        <li>
            <a class="dropdown-item text-center text-primary fw-bold" href="/Products">
                Перейти к списку товаров →
            </a>
        </li>
    </ul>
</li>