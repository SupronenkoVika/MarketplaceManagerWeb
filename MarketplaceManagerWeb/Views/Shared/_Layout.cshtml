<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketplaceManagerWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketplaceManagerWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MarketplaceManagerWeb</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">Главная</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Sales" asp-action="Index">Продажи</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Products" asp-action="Index">Товары</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Marketplaces" asp-action="Index">Маркетплейсы</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Reports" asp-action="Index">Отчеты</a>
    </li>
    <!-- Ссылка только для администраторов -->
                        @if (User.IsInRole("Admin"))
                        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Managers" asp-action="Index"> Менеджеры</a>
            </li>
                        }
</ul>
<!-- ДОБАВЛЯЕМ КОЛОКОЛЬЧИК УВЕДОМЛЕНИЙ СПРАВА -->
<ul class="navbar-nav">
                        @await Component.InvokeAsync("Notifications")

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
            <li class="nav-item dropdown ms-3">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    👤 @User.Identity.Name 
                                    @if (User.IsInRole("Admin"))
                                    {
                            <span class="badge bg-danger ms-2" style="font-size: 0.7em;">Админ</span>
                                    }
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                    <li>
                        <a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword">
                            🔑 Сменить пароль
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" asp-controller="Auth" asp-action="Logout" class="d-inline">
                            <button type="submit" class="dropdown-item text-danger">🚪 Выйти</button>
                        </form>
                    </li>
                </ul>
            </li>
                        }
</ul>
        </div>
    </div>
</nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MarketplaceManagerWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
