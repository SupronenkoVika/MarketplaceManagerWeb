@{
    ViewData["Title"] = ViewBag.ReportType + " - Отчет";
    var reportData = Model as dynamic;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Отчет: @ViewBag.ReportType</h1>
    <div class="d-flex gap-2">
            @if (ViewBag.StartDate != null || ViewBag.EndDate != null)
            {
                <span class="badge bg-secondary fs-6 align-self-center">
                    Период: @(ViewBag.StartDate ?? "начало") - @(ViewBag.EndDate ?? "сейчас")
                </span>
            }

        <!-- Кнопка экспорта в Excel -->
            @if (ViewBag.ReportType == "Менеджеры")
            {
                <form method="post" action="/Reports/ExportManagers" class="d-inline">
                    <input type="hidden" name="startDate" value="@ViewBag.StartDate" />
                    <input type="hidden" name="endDate" value="@ViewBag.EndDate" />
                    <button type="submit" class="btn btn-success">
                        📊 Скачать Excel
                    </button>
                </form>
            }
            else if (ViewBag.ReportType == "Маркетплейсы")
            {
                <form method="post" action="/Reports/ExportMarketplaces" class="d-inline">
                    <input type="hidden" name="startDate" value="@ViewBag.StartDate" />
                    <input type="hidden" name="endDate" value="@ViewBag.EndDate" />
                    <button type="submit" class="btn btn-success">
                        📊 Скачать Excel
                    </button>
                </form>
            }
            else if (ViewBag.ReportType == "Товары")
            {
                <form method="post" action="/Reports/ExportProducts" class="d-inline">
                    <input type="hidden" name="startDate" value="@ViewBag.StartDate" />
                    <input type="hidden" name="endDate" value="@ViewBag.EndDate" />
                    <button type="submit" class="btn btn-success">
                        📊 Скачать Excel
                    </button>
                </form>
            }

        <a asp-action="Index" class="btn btn-secondary">Новый отчет</a>
    </div>
</div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
    <tr>
                        @if (ViewBag.ReportType == "Менеджеры")
                        {
                            <th>Менеджер</th>
                        }
                        else if (ViewBag.ReportType == "Маркетплейсы")
                        {
                            <th>Маркетплейс</th> <th>Комиссия %</th>
                        }
                        else if (ViewBag.ReportType == "Товары")
                        {
                            <th>Артикул</th> <th>Товар</th>
                        }

        <th>Кол-во продаж</th>
                        @if (ViewBag.ReportType == "Товары")
                        {
                            <th>Общее кол-во</th>
                        }

        <th>Выручка</th>
        <th>Комиссии</th>
        <th>Логистика</th> 
        <th>Чистая прибыль</th>
    </tr>
</thead>
                <tbody>
                    @foreach (var item in (IEnumerable<dynamic>)Model)
                    {
            <tr>
                            @if (ViewBag.ReportType == "Менеджеры")
                            {
                                <td><strong>@item.ManagerName</strong></td>
                            }
                            else if (ViewBag.ReportType == "Маркетплейсы")
                            {
                                <td><strong>@item.MarketplaceName</strong></td> <td>@item.CommissionRate%</td>
                            }
                            else if (ViewBag.ReportType == "Товары")
                            {
                                <td><code>@item.ProductArticle</code></td> <td>@item.ProductName</td>
                            }

                <td>@item.SalesCount</td>
                            @if (ViewBag.ReportType == "Товары")
                            {
                                <td>@item.TotalQuantity</td>
                            }

                <td>@(((decimal)item.TotalRevenue).ToString("N2")) ₽</td>
                <td>@(((decimal)item.TotalCommission).ToString("N2")) ₽</td>
                <td>@(((decimal)item.TotalLogistics).ToString("N2")) ₽</td> <!-- ДОБАВЛЕНО -->
                <td class="text-success fw-bold">@(((decimal)item.TotalProfit).ToString("N2")) ₽</td>
            </tr>
                    }
</tbody>
                <tfoot class="table-light">
    <tr class="fw-bold">
                        @if (ViewBag.ReportType == "Менеджеры")
                        {
                            <td>ИТОГО:</td>
                        }
                        else if (ViewBag.ReportType == "Маркетплейсы")
                        {
                            <td colspan="2">ИТОГО:</td>
                        }
                        else if (ViewBag.ReportType == "Товары")
                        {
                            <td colspan="2">ИТОГО:</td>
                        }

        <td>@((Model as IEnumerable<dynamic>).Sum(x => (int)x.SalesCount))</td>
                        @if (ViewBag.ReportType == "Товары")
                        {
                            <td>@((Model as IEnumerable<dynamic>).Sum(x => (int)x.TotalQuantity))</td>
                        }

        <td>@((Model as IEnumerable<dynamic>).Sum(x => (decimal)x.TotalRevenue).ToString("N2")) ₽</td>
        <td>@((Model as IEnumerable<dynamic>).Sum(x => (decimal)x.TotalCommission).ToString("N2")) ₽</td>
        <td>@((Model as IEnumerable<dynamic>).Sum(x => (decimal)x.TotalLogistics).ToString("N2")) ₽</td> <!-- ДОБАВЛЕНО -->
        <td class="text-success">@((Model as IEnumerable<dynamic>).Sum(x => (decimal)x.TotalProfit).ToString("N2")) ₽</td>
    </tr>
</tfoot>
            </table>

            @if (!(Model as IEnumerable<dynamic>).Any())
            {
                    <div class="alert alert-info">
                        Нет данных для отображения за выбранный период
                    </div>
            }
        </div>
    </div>
</div>