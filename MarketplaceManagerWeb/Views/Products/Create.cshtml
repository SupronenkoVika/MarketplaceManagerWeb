@model MarketplaceManagerWeb.Models.Product

@{
    ViewData["Title"] = "Добавить товар";
}

<div class="container mt-4">
    <h1>Добавить товар</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="ProductArticle" class="control-label">Артикул</label>
                    <input asp-for="ProductArticle" class="form-control" placeholder="Например: ART-001" />
                    <span asp-validation-for="ProductArticle" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="control-label">Наименование</label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>

                <div class="mb-3">
    <label asp-for="CostPrice" class="control-label">Себестоимость (руб.)</label>
    <input asp-for="CostPrice" class="form-control" type="number" step="0.01" min="0" />
    <span asp-validation-for="CostPrice" class="text-danger"></span>
    <small class="form-text text-muted">Закупочная цена товара</small>
</div>

                <div class="mb-3">
                    <label asp-for="Stock" class="control-label">Остаток на складе</label>
                    <input asp-for="Stock" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>