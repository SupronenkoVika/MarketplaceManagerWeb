@model MarketplaceManagerWeb.Models.Marketplace

@{
    ViewData["Title"] = "Добавить маркетплейс";
}

<div class="container mt-4">
    <h1>Добавить маркетплейс</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="MarketplaceName" class="control-label">Название</label>
                    <input asp-for="MarketplaceName" class="form-control" placeholder="Например: Wildberries" />
                    <span asp-validation-for="MarketplaceName" class="text-danger"></span>
                </div>

                <div class="mb-3">
    <label asp-for="CommissionRate" class="control-label">Комиссия (%)</label>
    <input asp-for="CommissionRate" class="form-control" type="number" step="0.01" min="0" max="100" />
    <span asp-validation-for="CommissionRate" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="LogisticsCost" class="control-label">Стоимость логистики (руб.)</label>
    <input asp-for="LogisticsCost" class="form-control" type="number" step="0.01" min="0" />
    <span asp-validation-for="LogisticsCost" class="text-danger"></span>
    <small class="form-text text-muted">Средняя стоимость доставки одной единицы товара</small>
</div>


                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>