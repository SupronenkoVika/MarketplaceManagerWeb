@model IEnumerable<MarketplaceManagerWeb.Models.Marketplace>

@{
    ViewData["Title"] = "Маркетплейсы";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Справочник маркетплейсов</h1>
        <a asp-action="Create" class="btn btn-primary">+ Добавить маркетплейс</a>
    </div>

    @if (TempData["Error"] != null)
    {
            <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
    }

    <table class="table table-striped table-hover">
        <thead class="table-dark">
    <tr>
        <th>Название</th>
        <th>Комиссия (%)</th>
        <th>Логистика (руб.)</th>
        <th>Действия</th>
    </tr>
</thead>
<tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td><strong>@item.MarketplaceName</strong></td>
                <td>@item.CommissionRate%</td>
                <td>@item.LogisticsCost.ToString("N2") ₽</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MarketplaceID" class="btn btn-sm btn-outline-primary">Изменить</a>
                    <a asp-action="Delete" asp-route-id="@item.MarketplaceID" class="btn btn-sm btn-outline-danger">Удалить</a>
                </td>
            </tr>
            }
</tbody>
    </table>

    @if (!Model.Any())
    {
            <div class="alert alert-info">Маркетплейсов пока нет.</div>
    }
</div>