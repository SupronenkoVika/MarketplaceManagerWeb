@model IEnumerable<MarketplaceManagerWeb.Models.Sale>

@{
    ViewData["Title"] = "Главная панель";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4">📊 Главная панель аналитики</h1>

    <!-- Карточки с ключевыми показателями -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Всего продаж</h6>
                    <h2 class="mb-0">@ViewBag.TotalSales</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Общая выручка</h6>
                    <h2 class="mb-0">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) ₽</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase">Чистая прибыль</h6>
                    <h2 class="mb-0">@(((decimal)ViewBag.TotalProfit).ToString("N0")) ₽</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Графики -->
    <div class="row mb-4">
        <!-- График 1: По дням в штуках -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📈 Продажи по дням (в штуках, за 30 дней)</h5>
                </div>
                <div class="card-body">
                    <canvas id="dailyQtyChart"></canvas>
                </div>
            </div>
        </div>

        <!-- График 2: По маркетплейсам в штуках -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">🏪 Продажи по маркетплейсам (в штуках)</h5>
                </div>
                <div class="card-body">
                    <canvas id="marketplaceQtyChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Последние продажи -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">🕒 Последние продажи</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Товар</th>
                            <th>Маркетплейс</th>
                            <th>Менеджер</th>
                            <th>Кол-во</th>
                            <th>Прибыль</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in Model)
                        {
                                <tr>
                                    <td>@sale.SaleDate.ToString("dd.MM.yyyy")</td>
                                    <td>@sale.Product?.ProductName</td>
                                    <td><span class="badge bg-secondary">@sale.Marketplace?.MarketplaceName</span></td>
                                    <td>@sale.Manager?.ManagerFName @sale.Manager?.ManagerLName</td>
                                    <td class="fw-bold">@sale.Quantity шт.</td>
                                    <td class="text-success fw-bold">@sale.NetProfit.ToString("N2") ₽</td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                    <p class="text-muted text-center py-3">Продаж пока нет. Добавьте первую продажу!</p>
            }
        </div>
    </div>
</div>

@section Scripts {
        <!-- Подключаем Chart.js, если он еще не подключен в _Layout.cshtml -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <script>
            // Получаем данные из ViewBag с безопасной обработкой null
            const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DailyQtyLabels ?? Array.Empty<string>()));
            const dailyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DailyQuantities ?? Array.Empty<int>()));

            const mpLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MarketplaceQtyLabels ?? Array.Empty<string>()));
            const mpData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MarketplaceQuantities ?? Array.Empty<int>()));

            // 1. График продаж по дням (Столбчатая диаграмма)
            const dailyCtx = document.getElementById('dailyQtyChart').getContext('2d');
            new Chart(dailyCtx, {
                type: 'bar',
                data: {
                    labels: dailyLabels,
                    datasets: [{
                        label: 'Продано (шт.)',
                        data: dailyData,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { 
                            beginAtZero: true,
                            ticks: { stepSize: 1 } // Только целые числа
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // 2. График продаж по маркетплейсам (Кольцевая диаграмма)
            const mpCtx = document.getElementById('marketplaceQtyChart').getContext('2d');
            new Chart(mpCtx, {
                type: 'doughnut',
                data: {
                    labels: mpLabels,
                    datasets: [{
                        data: mpData,
                        backgroundColor: [
                            '#FF6384', // Wildberries (розовый)
                            '#36A2EB', // Ozon (синий)
                            '#FFCE56', // Яндекс (желтый)
                            '#4BC0C0', // Другие
                            '#9966FF'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: 'bottom',
                            labels: { padding: 20 }
                        }
                    }
                }
            });
        </script>
}