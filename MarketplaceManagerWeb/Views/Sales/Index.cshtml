@model IEnumerable<MarketplaceManagerWeb.Models.Sale>

@{
    ViewData["Title"] = "Продажи";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Список продаж</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Добавить продажу
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Дата</th>
                <th>Товар</th>
                <th>Маркетплейс</th>
                <th>Менеджер</th>
                <th>Кол-во</th>
                <th>Сумма</th>
                <th>Комиссия</th>
                <th>Чистая прибыль</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                    <tr>
                        <td>@item.SaleDate.ToString("dd.MM.yyyy")</td>
                        <td>@item.Product?.ProductName</td>
                        <td>@item.Marketplace?.MarketplaceName</td>
                        <td>@item.Manager?.ManagerFName @item.Manager?.ManagerLName</td>
                        <td>@item.Quantity</td>
                        <td>@item.TotalAmount.ToString("N2") руб.</td>
                        <td>@item.Commission.ToString("N2") руб.</td>
                        <td class="text-success fw-bold">@item.NetProfit.ToString("N2") руб.</td>
                    </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
            <div class="alert alert-info">
                Продаж пока нет. Добавьте первую продажу!
            </div>
    }
</div>