@model MarketplaceManagerWeb.Models.Sale

@{
    ViewData["Title"] = "Добавить продажу";
    var products = ViewBag.Products as List<MarketplaceManagerWeb.Models.Product>;
    var marketplaces = ViewBag.Marketplaces as List<MarketplaceManagerWeb.Models.Marketplace>;
}

<div class="container mt-4">
    <h1>Добавить продажу</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="ProductID" class="control-label">Товар</label>
                    <select asp-for="ProductID" class="form-select" id="productSelect">
                        <option value="">-- Выберите товар --</option>
                        @foreach (var product in products)
                        {
                                <option value="@product.ProductID" 
                                        data-price="@product.Price"
                                        data-stock="@product.Stock">
                                @product.ProductName (Артикул: @product.ProductArticle, Остаток: @product.Stock)
                                </option>
                        }
                    </select>
                    <span asp-validation-for="ProductID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MarketplaceID" class="control-label">Маркетплейс</label>
                    <select asp-for="MarketplaceID" class="form-select" id="marketplaceSelect">
                        <option value="">-- Выберите маркетплейс --</option>
                        @foreach (var marketplace in marketplaces)
                        {
                                <option value="@marketplace.MarketplaceID" 
                                        data-commission="@marketplace.CommissionRate">
                                @marketplace.MarketplaceName (Комиссия: @marketplace.CommissionRate%)
                                </option>
                        }
                    </select>
                    <span asp-validation-for="MarketplaceID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="control-label">Количество</label>
                    <input asp-for="Quantity" class="form-control" id="quantityInput" min="1" value="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Расчет</h5>
                        <p class="mb-1">Цена за единицу: <span id="priceDisplay">0.00</span> руб.</p>
                        <p class="mb-1">Комиссия: <span id="commissionRateDisplay">0</span>%</p>
                        <hr />
                        <p class="mb-1 fw-bold">Итого: <span id="totalDisplay">0.00</span> руб.</p>
                        <p class="mb-1 text-danger">Комиссия: <span id="commissionDisplay">0.00</span> руб.</p>
                        <p class="mb-0 text-success fw-bold">Чистая прибыль: <span id="profitDisplay">0.00</span> руб.</p>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
        <script>
            const productSelect = document.getElementById('productSelect');
            const marketplaceSelect = document.getElementById('marketplaceSelect');
            const quantityInput = document.getElementById('quantityInput');

            const priceDisplay = document.getElementById('priceDisplay');
            const commissionRateDisplay = document.getElementById('commissionRateDisplay');
            const totalDisplay = document.getElementById('totalDisplay');
            const commissionDisplay = document.getElementById('commissionDisplay');
            const profitDisplay = document.getElementById('profitDisplay');

            function calculateTotals() {
                const selectedProduct = productSelect.options[productSelect.selectedIndex];
                const selectedMarketplace = marketplaceSelect.options[marketplaceSelect.selectedIndex];
                const quantity = parseInt(quantityInput.value) || 0;

                const price = parseFloat(selectedProduct?.dataset.price || 0);
                const commissionRate = parseFloat(selectedMarketplace?.dataset.commission || 0);

                const total = price * quantity;
                const commission = total * commissionRate / 100;
                const profit = total - commission;

                priceDisplay.textContent = price.toFixed(2);
                commissionRateDisplay.textContent = commissionRate;
                totalDisplay.textContent = total.toFixed(2);
                commissionDisplay.textContent = commission.toFixed(2);
                profitDisplay.textContent = profit.toFixed(2);
            }

            productSelect.addEventListener('change', calculateTotals);
            marketplaceSelect.addEventListener('change', calculateTotals);
            quantityInput.addEventListener('input', calculateTotals);
        </script>
}